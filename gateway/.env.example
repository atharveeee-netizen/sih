# HoneyChain gateway -- blockchain connection settings.
# Copy this file to gateway/.env (the gateway auto-loads it via python-dotenv if installed).
#
# Values below are for a LOCAL Hardhat node (npx hardhat node, run from contracts/),
# after deploying with: node deploy_local.js  (from contracts/, after node compile.js).
# HoneyChain deployed first from account #0 always lands at the address below on a
# fresh Hardhat node; HoneyChainQR deployed second always lands at its address below.
# These are Hardhat's own well-known local test values -- never use them, or the
# private key below, on a real network.

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
HONEYCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
HONEYCHAIN_QR_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
